# ==============================================================================
# NearbyConvo — Environment Variables Template
#
# This file is intentionally safe to commit to a public repository.
# NEVER put real passwords, API tokens, secret keys, or connection strings
# containing real credentials in this file.
#
# Copy to .env.local for local development and fill in the real values.
# Production secrets should be configured in the relevant deployment platform
# (for example, Cloudflare Secrets / CI secrets), not committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application
# ------------------------------------------------------------------------------

# Node environment used by the application and tooling.
NODE_ENV="development"

# Public URL of the Next.js application.
# Local example: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Supabase — Project & Client Access
# ------------------------------------------------------------------------------

# Your Supabase project URL.
# Find it in Supabase Dashboard → Project Settings → General.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Modern Supabase publishable API key.
# Starts with: sb_publishable_
# Safe to expose in browser/client-side code when Row Level Security is
# correctly configured. This replaces the legacy `anon` key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"

# Modern Supabase secret API key.
# Starts with: sb_secret_
# SERVER-ONLY. Never expose this to the browser or commit a real value.
# This replaces the legacy `service_role` key.
SUPABASE_SECRET_KEY="sb_secret_YOUR_KEY"

# ------------------------------------------------------------------------------
# 3. PostgreSQL / Prisma
# ------------------------------------------------------------------------------

# Transaction-mode pooler connection used by the production application.
# Port 6543 is intended for serverless / edge workloads.
# Obtain the exact connection string from Supabase Dashboard → Connect.
# Do not commit a real password or connection string.
DATABASE_URL="postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-YOUR_REGION.pooler.supabase.com:6543/postgres"

# Direct PostgreSQL connection used by Prisma CLI for migrations and other
# database-management operations.
# Obtain the exact connection string from Supabase Dashboard → Connect.
DIRECT_URL="postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Cloudflare Worker / WebSocket Endpoints
# ------------------------------------------------------------------------------

# Public HTTP API URL exposed by the Cloudflare Worker.
# Local example: http://127.0.0.1:8787
# Production example: https://api.example.com
NEXT_PUBLIC_WORKER_URL="http://127.0.0.1:8787"

# Public WebSocket URL exposed by the Cloudflare Worker.
# Local example: ws://127.0.0.1:8787
# Production example: wss://api.example.com
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:8787"

# ------------------------------------------------------------------------------
# 5. Matching Configuration
# ------------------------------------------------------------------------------

# Maximum allowed distance between matched users, in meters, after campus
# eligibility has been established.
MAX_MATCHING_DISTANCE_METERS="1000"

# ------------------------------------------------------------------------------
# 6. Realtime / Abuse-Control Configuration
# ------------------------------------------------------------------------------

# Maximum normal chat messages accepted from one user per minute.
MESSAGE_RATE_LIMIT_PER_MINUTE="20"

# ------------------------------------------------------------------------------
# 7. Automatic Report-Based Ban Thresholds
# ------------------------------------------------------------------------------

# Distinct reporters required for an automatic 24-hour ban.
REPORT_THRESHOLD_24H="6"

# Distinct reporters required for an automatic 7-day ban.
REPORT_THRESHOLD_7D="11"

# Distinct reporters required for an automatic permanent ban.
REPORT_THRESHOLD_PERMANENT="20"

# ------------------------------------------------------------------------------
# 8. Cloudflare Deployment / Wrangler
# ------------------------------------------------------------------------------

# Cloudflare account identifier used by Wrangler/CI.
# This is not an application runtime secret, but keep deployment credentials
# out of committed files.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# Cloudflare API token used by Wrangler/CI for deployment.
# SERVER/CI-ONLY. Never expose this to browser code.
# Prefer configuring it as a Cloudflare/CI secret rather than storing it locally
# except in an ignored local environment file when needed.
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# ==============================================================================
# IMPORTANT
#
# Never add any of the following legacy Supabase key names to this project:
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Use the modern key names above instead:
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SECRET_KEY
#
# Also never commit real values for:
#   SUPABASE_SECRET_KEY
#   DATABASE_URL
#   DIRECT_URL
#   CLOUDFLARE_API_TOKEN
#
# `.env.example` is a template. `.env.local` / deployment secrets contain the
# real credentials and must remain outside version control.
# ==============================================================================
