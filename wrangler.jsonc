{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mezship",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROXIMITY_MATCHER",
        "class_name": "ProximityMatcherDO"
      },
      {
        "name": "MATCH_ROOM",
        "class_name": "MatchRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CampusMatcherDO", "MatchRoomDO"]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "CampusMatcherDO",
          "to": "ProximityMatcherDO"
        }
      ]
    }
  ],
  "vars": {
    "NODE_ENV": "development",
    "REPORT_THRESHOLD_24H": "6",
    "REPORT_THRESHOLD_7D": "11",
    "REPORT_THRESHOLD_PERMANENT": "20"
  },
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  }
}
